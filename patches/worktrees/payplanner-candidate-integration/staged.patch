+public partial class CasesV2ControllerTests
+{
+    [Theory]
+    [InlineData(false, "case-only", false)]
+    [InlineData(true, "case-only", false)]
+    [InlineData(false, "denied-own", false)]
+    [InlineData(true, "denied-own", false)]
