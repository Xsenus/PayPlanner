import { StrictMode } from 'react';
import userEvent from '@testing-library/user-event';
import { act, fireEvent, render, screen, waitFor } from '@testing-library/react';
import { beforeEach, describe, expect, it, vi } from 'vitest';
import Navigation from './Navigation';
import { getTabHref } from '../../appRouting';
import { ALL_TABS, type Tab } from '../../types/tabs';
import { apiService } from '../../services/api';
import { defaultRestrictedRolePermissions, defaultRolePermissions, type RolePermissions } from '../../types/permissions';
import {
  PAYMENT_ADVANCE_REVIEW_CHANGED_EVENT,
  PAYMENT_ADVANCE_REVIEW_FILTER_INTENT_KEY,
} from '../../utils/paymentAdvanceReview';

const authState = vi.hoisted(() => ({
  userId: 1 as number | null,
  isAdmin: true,
  roleId: 1,
  roleName: 'admin',
}));

const toastMocks = vi.hoisted(() => ({
  success: vi.fn(),
  error: vi.fn(),
  info: vi.fn(),
}));

vi.mock('../../contexts/AuthContext', () => ({
  useAuth: () => ({
    user: authState.userId === null ? null : { id: authState.userId, role: { id: authState.roleId, name: authState.roleName } },
    isAdmin: () => authState.isAdmin,
  }),
}));

vi.mock('../../services/api', () => ({
  apiService: {
    getPaymentsV2: vi.fn(),
    getRolePermissions: vi.fn(),
    getNavigationSettings: vi.fn(),
    updateNavigationSettings: vi.fn(),
    getUserSetting: vi.fn(),
    upsertUserSetting: vi.fn(),
  },
}));

vi.mock('../../hooks/useToast', () => ({
  useToast: () => toastMocks,
}));

const apiMock = vi.mocked(apiService);
let nextRoleId = 1000;

const expandedSections = {
  tasks: true,
  contacts: true,
  accounts: true,
  money: true,
  payments: true,
  acts: true,
};

const HIDDEN_NAVIGATION_TABS = [
  'caseDetail',
  'clients',
  'legalEntities',
  'contactsExternal',
  'actCreate',
  'actDetail',
  'contractCreate',
  'contractDetail',
  'clientDetail',
  'companyProfile',
  'profile',
  'userDetail',
  'yandexDisk',
  's3Storage',
] as const satisfies readonly Tab[];

const lawyerWorkSection = {
  canView: true,
  canCreate: true,
  canEdit: true,
  canDelete: false,
  canExport: false,
  viewScope: 'own',
} as const;

const lawyerTaskSection = {
  ...lawyerWorkSection,
  canEditOthers: false,
  canCompleteOthers: false,
  canDeleteOthers: false,
} as const;

function createLawyerTemplatePermissions(): RolePermissions {
  return {
    ...defaultRestrictedRolePermissions,
    calendar: { ...lawyerWorkSection, canViewAnalytics: false, visibleUserIds: [] },
    tasks: { ...lawyerTaskSection },
    clients: { ...lawyerWorkSection },
    cases: { ...lawyerWorkSection },
    notifications: {
      canView: true,
      canCreate: false,
      canEdit: true,
      canDelete: false,
      canExport: false,
      viewScope: 'all',
    },
  };
}

function renderNavigation(onTabChange = vi.fn()) {
  window.localStorage.setItem(`pp.sidebar_expanded.${authState.userId}`, JSON.stringify(expandedSections));
  render(<Navigation activeTab="calendar" onTabChange={onTabChange} />);
  return onTabChange;
}

function findLinkByHref(tabHref: string) {
  const normalizedHref = new URL(tabHref, window.location.origin).href;
  return screen
    .getAllByRole('link')
    .find((link) => link.getAttribute('href') === tabHref || (link as HTMLAnchorElement).href === normalizedHref);
}

async function waitForNavigationPermissions() {
  await waitFor(() => {
    expect(findLinkByHref(getTabHref('calendar'))).toBeTruthy();
  });
}

describe('Navigation links', () => {
  beforeEach(() => {
    window.history.replaceState({}, '', '/');
    window.localStorage.clear();
    window.sessionStorage.clear();
    vi.clearAllMocks();
    authState.userId = 1;
    authState.isAdmin = true;
    // The real permissions service keeps its cache across component unmounts.
    // Each scenario needs a fresh role, while rerenders within it share the cache.
    authState.roleId = nextRoleId++;
    authState.roleName = 'admin';
    apiMock.getRolePermissions.mockReset().mockResolvedValue(defaultRolePermissions);
    apiMock.getNavigationSettings.mockResolvedValue({ order: [], labels: {}, groups: [], updatedAt: null });
    apiMock.updateNavigationSettings.mockImplementation(async (order, labels, groups) => ({ order, labels, groups, updatedAt: null }));
    apiMock.getUserSetting.mockResolvedValue(null);
    apiMock.upsertUserSetting.mockResolvedValue({ key: 'navigation.sidebar.hidden-items.v1', value: '[]' });
    apiMock.getPaymentsV2.mockResolvedValue({
      items: [],
      total: 0,
      page: 1,
      pageSize: 1,
      summary: {
        income: 0,
        expense: 0,
        balance: 0,
        incomeCount: 0,
        expenseCount: 0,
        total: 0,
      },
    });
  });

  describe('employee-owned sidebar layout', () => {
    it('does not apply a late hidden-section save failure after switching A to B and back', async () => {
      let rejectSave!: (reason: Error) => void;
      apiMock.upsertUserSetting.mockImplementationOnce(() => new Promise((_resolve, reject) => { rejectSave = reject; }));
      const user = userEvent.setup();
      const view = render(<Navigation activeTab="calendar" onTabChange={vi.fn()} />);
      await waitForNavigationPermissions();
      await user.click(screen.getByRole('button', { name: 'Ещё разделы' }));
      await user.click(screen.getByRole('checkbox', { name: /Отчёты/i }));
      await waitFor(() => expect(window.localStorage.getItem('pp.sidebar_hidden.1')).toContain('reports'));
      authState.userId = 2;
      view.rerender(<Navigation activeTab="calendar" onTabChange={vi.fn()} />);
      await waitFor(() => expect(findLinkByHref(getTabHref('reports'))).toBeTruthy());
      authState.userId = 1;
      view.rerender(<Navigation activeTab="calendar" onTabChange={vi.fn()} />);
      await waitFor(() => expect(findLinkByHref(getTabHref('reports'))).toBeUndefined());
      await act(async () => { rejectSave(new Error('late failure')); });
      expect(findLinkByHref(getTabHref('reports'))).toBeUndefined();
      expect(window.localStorage.getItem('pp.sidebar_hidden.1')).toContain('reports');
    });

    it('restores each employee hidden sections without writing the previous employee values to the new owner', async () => {
      window.localStorage.setItem('pp.sidebar_hidden.1', JSON.stringify(['calendar']));
      window.localStorage.setItem('pp.sidebar_hidden.2', JSON.stringify(['cases']));
      const writes = vi.spyOn(Storage.prototype, 'setItem');
      const view = render(<Navigation activeTab="calendar" onTabChange={vi.fn()} />);
      await waitFor(() => expect(findLinkByHref(getTabHref('calendar'))).toBeUndefined());
      writes.mockClear();
      authState.userId = 2;
      view.rerender(<Navigation activeTab="calendar" onTabChange={vi.fn()} />);
      await waitFor(() => expect(findLinkByHref(getTabHref('calendar'))).toBeTruthy());
      expect(findLinkByHref(getTabHref('cases'))).toBeUndefined();
      expect(writes.mock.calls.filter(([key]) => key === 'pp.sidebar_hidden.2').every(([, value]) => value === '["cases"]')).toBe(true);
      expect(window.localStorage.getItem('pp.sidebar_hidden.1')).toBe('["calendar"]');
      writes.mockRestore();
    });

    function toggleTaskSubmenu() {
      const toggle = findLinkByHref(getTabHref('tasks'))?.parentElement?.querySelector('button');
      if (!toggle) throw new Error('The visible task section must have its real expand control.');
      fireEvent.click(toggle);
    }

    it('restores A after B and reload without ever saving the previous layout under B', async () => {
      window.localStorage.setItem('pp.sidebar_collapsed.1', '1');
      window.localStorage.setItem('pp.sidebar_expanded.1', '{"tasks":false}');
      window.localStorage.setItem('pp.sidebar_collapsed.2', '0');
      window.localStorage.setItem('pp.sidebar_expanded.2', '{"tasks":true}');
      const writes = vi.spyOn(Storage.prototype, 'setItem');
      try {
        const view = render(<Navigation activeTab="calendar" onTabChange={vi.fn()} />);
        await waitForNavigationPermissions();
        expect(screen.getByRole('button', { name: 'Развернуть меню' })).toBeTruthy();

        authState.userId = 2;
        view.rerender(<Navigation activeTab="calendar" onTabChange={vi.fn()} />);
        await waitFor(() => expect(screen.getByRole('button', { name: 'Свернуть меню' })).toBeTruthy());
        expect(findLinkByHref(getTabHref('tasksApprovals'))).toBeTruthy();
        const collapsedWritesB = writes.mock.calls.filter(([key]) => key === 'pp.sidebar_collapsed.2');
        expect(collapsedWritesB.length).toBeGreaterThan(0);
        expect(collapsedWritesB.every(([, value]) => value === '0')).toBe(true);
        const expandedWritesB = writes.mock.calls.filter(([key]) => key === 'pp.sidebar_expanded.2');
        expect(expandedWritesB.length).toBeGreaterThan(0);
        expect(expandedWritesB.every(([, value]) => JSON.parse(value).tasks === true)).toBe(true);
        expect(window.localStorage.getItem('pp.sidebar_collapsed.1')).toBe('1');
        expect(window.localStorage.getItem('pp.sidebar_expanded.1')).toBe('{"tasks":false}');

        authState.userId = 1;
        view.rerender(<Navigation activeTab="calendar" onTabChange={vi.fn()} />);
        expect(screen.getByRole('button', { name: 'Развернуть меню' })).toBeTruthy();
        fireEvent.click(screen.getByRole('button', { name: 'Развернуть меню' }));
        expect(findLinkByHref(getTabHref('tasksApprovals'))).toBeFalsy();
        await waitFor(() => expect(window.localStorage.getItem('pp.sidebar_collapsed.1')).toBe('0'));
        view.unmount();
        render(<Navigation activeTab="calendar" onTabChange={vi.fn()} />);
        await waitForNavigationPermissions();
        expect(screen.getByRole('button', { name: 'Свернуть меню' })).toBeTruthy();
        expect(findLinkByHref(getTabHref('tasksApprovals'))).toBeFalsy();
        expect(window.localStorage.getItem('pp.sidebar_collapsed.2')).toBe('0');
        expect(window.localStorage.getItem('pp.sidebar_expanded.2')).toBe('{"tasks":true}');
      } finally {
        writes.mockRestore();
      }
    });

    it('starts with defaults instead of adopting ownerless globals and persists employee toggles', async () => {
      window.localStorage.setItem('pp.sidebar_collapsed', '1');
      window.localStorage.setItem('pp.sidebar_expanded', '{"tasks":true}');
      render(<Navigation activeTab="calendar" onTabChange={vi.fn()} />);
      await waitForNavigationPermissions();
      expect(screen.getByRole('button', { name: 'Свернуть меню' })).toBeTruthy();
      expect(findLinkByHref(getTabHref('tasksApprovals'))).toBeFalsy();
      toggleTaskSubmenu();
      expect(findLinkByHref(getTabHref('tasksApprovals'))).toBeTruthy();
      fireEvent.click(screen.getByRole('button', { name: 'Свернуть меню' }));
      await waitFor(() => expect(window.localStorage.getItem('pp.sidebar_collapsed.1')).toBe('1'));
      expect(JSON.parse(window.localStorage.getItem('pp.sidebar_expanded.1') ?? '{}').tasks).toBe(true);
      expect(window.localStorage.getItem('pp.sidebar_collapsed')).toBe('1');
      expect(window.localStorage.getItem('pp.sidebar_expanded')).toBe('{"tasks":true}');
    });

    it('keeps StrictMode logout and the next employee separate from guest and previous layout', async () => {
      window.localStorage.setItem('pp.sidebar_collapsed.1', '1');
      window.localStorage.setItem('pp.sidebar_expanded.1', '{"tasks":false}');
      window.localStorage.setItem('pp.sidebar_collapsed.2', '0');
      window.localStorage.setItem('pp.sidebar_expanded.2', '{"tasks":true}');
      window.localStorage.setItem('pp.sidebar_collapsed.guest', '1');
      window.localStorage.setItem('pp.sidebar_expanded.guest', '{"tasks":true}');
      const writes = vi.spyOn(Storage.prototype, 'setItem');
      try {
        const view = render(<StrictMode><Navigation activeTab="calendar" onTabChange={vi.fn()} /></StrictMode>);
        await waitForNavigationPermissions();
        expect(screen.getByRole('button', { name: 'Развернуть меню' })).toBeTruthy();
        authState.userId = null;
        view.rerender(<StrictMode><Navigation activeTab="calendar" onTabChange={vi.fn()} /></StrictMode>);
        expect(screen.getByRole('button', { name: 'Свернуть меню' })).toBeTruthy();
        authState.userId = 2;
        view.rerender(<StrictMode><Navigation activeTab="calendar" onTabChange={vi.fn()} /></StrictMode>);
        await waitFor(() => expect(findLinkByHref(getTabHref('tasksApprovals'))).toBeTruthy());
        expect(screen.getByRole('button', { name: 'Свернуть меню' })).toBeTruthy();
        expect(writes.mock.calls.filter(([key]) => key === 'pp.sidebar_collapsed.2').every(([, value]) => value === '0')).toBe(true);
        expect(writes.mock.calls.filter(([key]) => key === 'pp.sidebar_expanded.2').every(([, value]) => JSON.parse(value).tasks === true)).toBe(true);
        expect(writes.mock.calls.filter(([key]) => key === 'pp.sidebar_collapsed.guest' || key === 'pp.sidebar_expanded.guest')).toHaveLength(0);
        expect(window.localStorage.getItem('pp.sidebar_collapsed.guest')).toBe('1');
        expect(window.localStorage.getItem('pp.sidebar_expanded.guest')).toBe('{"tasks":true}');
      } finally {
        writes.mockRestore();
      }
    });

    it.each([null, 0, -1, Number.NaN, Number.POSITIVE_INFINITY, 1.5, Number.MAX_SAFE_INTEGER + 1])('does not read or persist employee layout for invalid actor %s', async (userId) => {
      authState.userId = userId;
      window.localStorage.setItem('pp.sidebar_collapsed', '1');
      window.localStorage.setItem('pp.sidebar_expanded', '{"tasks":true}');
      const writes = vi.spyOn(Storage.prototype, 'setItem');
      try {
        render(<Navigation activeTab="calendar" onTabChange={vi.fn()} />);
        expect(screen.getByRole('button', { name: 'Свернуть меню' })).toBeTruthy();
        fireEvent.click(screen.getByRole('button', { name: 'Свернуть меню' }));
        expect(screen.getByRole('button', { name: 'Развернуть меню' })).toBeTruthy();
        expect(writes.mock.calls.filter(([key]) => key.startsWith('pp.sidebar_collapsed.') || key.startsWith('pp.sidebar_expanded.'))).toHaveLength(0);
        expect(window.localStorage.getItem('pp.sidebar_collapsed')).toBe('1');
        expect(window.localStorage.getItem('pp.sidebar_expanded')).toBe('{"tasks":true}');
      } finally {
        writes.mockRestore();
      }
    });

    it.each(['null', '[]', '{"tasks":"false"}', '{', '42'])('ignores malformed expanded layout %s without hiding navigation', async (stored) => {
      window.localStorage.setItem('pp.sidebar_collapsed.1', 'invalid');
      window.localStorage.setItem('pp.sidebar_expanded.1', stored);
      render(<Navigation activeTab="calendar" onTabChange={vi.fn()} />);
      await waitForNavigationPermissions();
      expect(screen.getByRole('button', { name: 'Свернуть меню' })).toBeTruthy();
      expect(findLinkByHref(getTabHref('tasks'))).toBeTruthy();
      expect(findLinkByHref(getTabHref('tasksApprovals'))).toBeFalsy();
      toggleTaskSubmenu();
      expect(findLinkByHref(getTabHref('tasksApprovals'))).toBeTruthy();
      expect(JSON.parse(window.localStorage.getItem('pp.sidebar_expanded.1') ?? '{}').tasks).toBe(true);
    });

    it('keeps layout controls usable when only their local storage reads and writes throw', async () => {
      const originalGet = Storage.prototype.getItem;
      const originalSet = Storage.prototype.setItem;
      const isLayoutKey = (key: string) => key.startsWith('pp.sidebar_collapsed.') || key.startsWith('pp.sidebar_expanded.');
      const reads = vi.spyOn(Storage.prototype, 'getItem').mockImplementation(function (this: Storage, key: string) {
        if (isLayoutKey(key)) throw new Error('Synthetic layout storage unavailable');
        return originalGet.call(this, key);
      });
      const writes = vi.spyOn(Storage.prototype, 'setItem').mockImplementation(function (this: Storage, key: string, value: string) {
        if (isLayoutKey(key)) throw new Error('Synthetic layout storage unavailable');
        return originalSet.call(this, key, value);
      });
      try {
        render(<Navigation activeTab="calendar" onTabChange={vi.fn()} />);
        await waitForNavigationPermissions();
        expect(screen.getByRole('button', { name: 'Свернуть меню' })).toBeTruthy();
        toggleTaskSubmenu();
        expect(findLinkByHref(getTabHref('tasksApprovals'))).toBeTruthy();
        fireEvent.click(screen.getByRole('button', { name: 'Свернуть меню' }));
        expect(screen.getByRole('button', { name: 'Развернуть меню' })).toBeTruthy();
      } finally {
        reads.mockRestore();
        writes.mockRestore();
      }
    });

    it('does not reload a manually changed layout when the same employee permissions refresh', async () => {
      const view = render(<Navigation activeTab="calendar" onTabChange={vi.fn()} />);
      await waitForNavigationPermissions();
      toggleTaskSubmenu();
      fireEvent.click(screen.getByRole('button', { name: 'Свернуть меню' }));
      expect(screen.getByRole('button', { name: 'Развернуть меню' })).toBeTruthy();
      window.localStorage.setItem('pp.sidebar_collapsed.1', '0');
      window.localStorage.setItem('pp.sidebar_expanded.1', '{"tasks":false}');
      const reads = vi.spyOn(Storage.prototype, 'getItem');
      try {
        authState.roleId = 147001;
        authState.roleName = 'employee';
        view.rerender(<Navigation activeTab="calendar" onTabChange={vi.fn()} />);
        expect(screen.getByRole('button', { name: 'Развернуть меню' })).toBeTruthy();
        expect(reads.mock.calls.filter(([key]) => key === 'pp.sidebar_collapsed.1' || key === 'pp.sidebar_expanded.1')).toHaveLength(0);
      } finally {
        reads.mockRestore();
      }
    });
  });

  it('keeps page padding aligned with the desktop sidebar breakpoint', async () => {
    renderNavigation();
    await waitForNavigationPermissions();

    const responsiveStyles = document.getElementById('pp-sidebar-style');
    expect(responsiveStyles?.textContent).toContain('@media (max-width: 1023px)');
    expect(responsiveStyles?.textContent).not.toContain('@media (max-width: 1024px)');
  });

  it('renders navigation destinations as real links', async () => {
    renderNavigation();
    await waitForNavigationPermissions();

    expect(screen.getByRole('complementary', { name: 'Навигация' })).toBeTruthy();
    expect(screen.getByRole('navigation', { name: 'Навигация' })).toBeTruthy();
    expect(findLinkByHref(getTabHref('workspace'))).toBeTruthy();
    expect(findLinkByHref(getTabHref('payroll'))).toBeTruthy();
    expect(findLinkByHref(getTabHref('calendar'))).toBeTruthy();
    expect(findLinkByHref(getTabHref('notifications'))).toBeTruthy();
    expect(findLinkByHref(getTabHref('tasksApprovals'))).toBeTruthy();
    expect(findLinkByHref(getTabHref('tasksUntriaged'))?.textContent).toContain('Неразобранные');
    expect(findLinkByHref(getTabHref('tasksCalendar'))).toBeTruthy();
    expect(screen.getByRole('link', { name: /^Контакты$/i }).getAttribute('href')).toBe(getTabHref('contacts'));
    expect(findLinkByHref(getTabHref('accountsIncome'))).toBeTruthy();
    expect(findLinkByHref(getTabHref('moneyEMoney'))).toBeTruthy();
    expect(findLinkByHref(getTabHref('settings'))).toBeTruthy();
    expect(findLinkByHref(getTabHref('yandexDisk'))).toBeFalsy();
    expect(findLinkByHref(getTabHref('s3Storage'))).toBeFalsy();
  });

  it('shows court work under tasks', async () => {
    renderNavigation();
    await waitForNavigationPermissions();
    expect(findLinkByHref(getTabHref('courtCases'))?.textContent).toContain('Суд');
    expect(screen.queryByRole('link', { name: 'Судебные дела' })).toBeNull();
  });

  it('keeps court work visible to a cases-only role', async () => {
    authState.isAdmin = false;
    apiMock.getRolePermissions.mockResolvedValueOnce({
      ...defaultRestrictedRolePermissions,
      cases: { ...lawyerWorkSection },
    });
    renderNavigation();
    await waitFor(() => expect(findLinkByHref(getTabHref('courtCases'))?.textContent).toContain('Судебные дела'));
  });

  it('uses the common server order and custom section names', async () => {
    apiMock.getNavigationSettings.mockResolvedValueOnce({
      order: ['tasks', 'calendar', 'notifications'],
      labels: { tasks: 'Рабочие задачи' },
      groups: [],
      updatedAt: null,
    });

    renderNavigation();
    await screen.findByRole('link', { name: /Рабочие задачи/i });

    const navigation = screen.getByRole('navigation', { name: 'Навигация' });
    const topLevelLinks = Array.from(navigation.querySelectorAll('ul > li > div > a')).map((link) =>
      (link.textContent ?? '').trim(),
    );

    expect(topLevelLinks[0] ?? '').toContain('Рабочие задачи');
    expect(topLevelLinks[1] ?? '').toContain('Календарь');
    expect(topLevelLinks[2] ?? '').toContain('Уведомления');
  });

  it('lets a user hide and restore only available sections', async () => {
    const user = userEvent.setup();
    renderNavigation();
    await waitForNavigationPermissions();

    await user.click(screen.getByRole('button', { name: 'Ещё разделы' }));
    const reportsCheckbox = screen.getByRole('checkbox', { name: /Отчёты/i });
    await user.click(reportsCheckbox);
    expect(findLinkByHref(getTabHref('reports'))).toBeFalsy();

    await waitFor(() => {
      expect(apiMock.upsertUserSetting).toHaveBeenCalledWith(
        'navigation.sidebar.hidden-items.v1',
        expect.stringContaining('reports'),
      );
    });

    await user.click(reportsCheckbox);
    expect(findLinkByHref(getTabHref('reports'))).toBeTruthy();
  });

  it('saves rapid visibility changes in order even if the first request is slow', async () => {
    let finishFirst!: (value: { key: string; value: string }) => void;
    apiMock.upsertUserSetting.mockImplementationOnce(() => new Promise((resolve) => { finishFirst = resolve; }));
    apiMock.upsertUserSetting.mockResolvedValueOnce({ key: 'navigation.sidebar.hidden-items.v1', value: '[]' });
    const user = userEvent.setup();
    renderNavigation();
    await waitForNavigationPermissions();
    await user.click(screen.getByRole('button', { name: 'Ещё разделы' }));
    const checkbox = screen.getByRole('checkbox', { name: /Отчёты/i });
    await user.click(checkbox);
    await user.click(checkbox);
    expect(findLinkByHref(getTabHref('reports'))).toBeTruthy();
    expect(apiMock.upsertUserSetting).toHaveBeenCalledTimes(1);
    await act(async () => finishFirst({ key: 'navigation.sidebar.hidden-items.v1', value: '["reports"]' }));
    await waitFor(() => expect(apiMock.upsertUserSetting).toHaveBeenCalledTimes(2));
    expect(apiMock.upsertUserSetting).toHaveBeenLastCalledWith('navigation.sidebar.hidden-items.v1', '[]');
  });

  it('does not replace a newly changed hidden section with a late settings read', async () => {
    let finishRead!: (value: { key: string; value: string }) => void;
    apiMock.getUserSetting.mockImplementationOnce(() => new Promise((resolve) => { finishRead = resolve; }));
    const user = userEvent.setup();
    renderNavigation();
    await waitForNavigationPermissions();
    await user.click(screen.getByRole('button', { name: 'Ещё разделы' }));
    await user.click(screen.getByRole('checkbox', { name: /Отчёты/i }));
    await act(async () => finishRead({ key: 'navigation.sidebar.hidden-items.v1', value: '[]' }));
    expect(findLinkByHref(getTabHref('reports'))).toBeUndefined();
  });

  it('restores the last confirmed hidden sections when queued saves fail', async () => {
    let failFirst!: (reason: Error) => void;
    apiMock.upsertUserSetting.mockImplementationOnce(() => new Promise((_resolve, reject) => { failFirst = reject; }));
    apiMock.upsertUserSetting.mockRejectedValueOnce(new Error('failed second save'));
    const user = userEvent.setup();
    renderNavigation();
    await waitForNavigationPermissions();
    await user.click(screen.getByRole('button', { name: 'Ещё разделы' }));
    const checkbox = screen.getByRole('checkbox', { name: /Отчёты/i });
    await user.click(checkbox);
    await user.click(checkbox);
    await act(async () => failFirst(new Error('failed first save')));
    await waitFor(() => expect(toastMocks.error).toHaveBeenCalled());
    expect(findLinkByHref(getTabHref('reports'))).toBeTruthy();
    expect(JSON.parse(window.localStorage.getItem('pp.sidebar_hidden.1') ?? '[]')).toEqual([]);
  });

  it('does not send queued visibility changes after switching employees', async () => {
    let finishFirst!: (value: { key: string; value: string }) => void;
    apiMock.upsertUserSetting.mockImplementationOnce(() => new Promise((resolve) => { finishFirst = resolve; }));
    const user = userEvent.setup();
    const view = render(<Navigation activeTab="calendar" onTabChange={vi.fn()} />);
    await waitForNavigationPermissions();
    await user.click(screen.getByRole('button', { name: 'Ещё разделы' }));
    const checkbox = screen.getByRole('checkbox', { name: /Отчёты/i });
    await user.click(checkbox);
    await user.click(checkbox);
    authState.userId = 2;
    view.rerender(<Navigation activeTab="calendar" onTabChange={vi.fn()} />);
    await waitFor(() => expect(findLinkByHref(getTabHref('reports'))).toBeTruthy());
    await act(async () => finishFirst({ key: 'navigation.sidebar.hidden-items.v1', value: '["reports"]' }));
    expect(apiMock.upsertUserSetting).toHaveBeenCalledTimes(1);
    expect(findLinkByHref(getTabHref('reports'))).toBeTruthy();
  });

  it('lets an administrator save the common order and names', async () => {
    const user = userEvent.setup();
    renderNavigation();
    await waitForNavigationPermissions();

    await user.click(screen.getByRole('button', { name: 'Ещё разделы' }));
    await user.click(screen.getByRole('button', { name: 'Группы и порядок' }));
    const calendarName = screen.getByRole('textbox', { name: /Название раздела Календарь/i });
    await user.clear(calendarName);
    await user.type(calendarName, 'Расписание');
    const calendarDragHandle = screen.getByRole('button', { name: 'Перетащить Календарь' });
    const notificationsRow = screen.getByRole('button', { name: 'Перетащить Уведомления' }).closest('div');
    fireEvent.pointerDown(calendarDragHandle, { button: 0, buttons: 1 });
    fireEvent.pointerMove(notificationsRow!, { buttons: 1 });
    fireEvent.pointerUp(notificationsRow!, { button: 0, buttons: 0 });
    await user.click(screen.getByRole('button', { name: 'Сохранить' }));

    await waitFor(() => expect(apiMock.updateNavigationSettings).toHaveBeenCalled());
    const [order, labels, groups] = apiMock.updateNavigationSettings.mock.calls.at(-1)!;
    expect(order[0]).toBe('workspace');
    expect(order[1]).toBe('notifications');
    expect(labels.calendar).toBe('Расписание');
    expect(groups).toEqual([]);
    expect(await screen.findByRole('link', { name: /Расписание/i })).toBeTruthy();
    expect(toastMocks.success).toHaveBeenCalledWith(
      'Порядок групп и разделов сохранён для всех пользователей.',
      'Настройки меню сохранены',
    );
  });

  it('keeps the settings open and shows a toast when saving fails', async () => {
    const user = userEvent.setup();
    apiMock.updateNavigationSettings.mockRejectedValueOnce(new Error('network error'));
    renderNavigation();
    await waitForNavigationPermissions();

    await user.click(screen.getByRole('button', { name: 'Ещё разделы' }));
    await user.click(screen.getByRole('button', { name: 'Группы и порядок' }));
    await user.click(screen.getByRole('button', { name: 'Сохранить' }));

    const message = 'Не удалось сохранить порядок меню. Повторите попытку.';
    expect(await screen.findByText(message)).toBeTruthy();
    expect(screen.getByRole('dialog', { name: 'Группы, порядок и названия разделов' })).toBeTruthy();
    expect(toastMocks.error).toHaveBeenCalledWith(message, 'Настройки меню не сохранены');
  });

  it('lets an administrator create, position and fill a menu group', async () => {
    const user = userEvent.setup();
    renderNavigation();
    await waitForNavigationPermissions();

    await user.click(screen.getByRole('button', { name: 'Ещё разделы' }));
    await user.click(screen.getByRole('button', { name: 'Группы и порядок' }));
    await user.click(screen.getByRole('button', { name: 'Создать группу' }));
    const groupName = screen.getByRole('textbox', { name: /Название группы Новая группа/i });
    await user.clear(groupName);
    await user.type(groupName, 'Бухгалтерия');
    const accountsGroupSelect = screen.getByRole('combobox', { name: /Группа раздела Счета/i }) as HTMLSelectElement;
    const groupValue = Array.from(accountsGroupSelect.options).find((option) => option.text === 'Бухгалтерия')?.value;
    expect(groupValue).toBeTruthy();
    await user.selectOptions(accountsGroupSelect, groupValue!);
    await user.selectOptions(screen.getByRole('combobox', { name: /Группа раздела Акты/i }), groupValue!);
    const groupDragHandle = screen.getByRole('button', { name: 'Перетащить группу Бухгалтерия' });
    const calendarRow = screen.getByRole('button', { name: 'Перетащить Календарь' }).closest('div');
    fireEvent.pointerDown(groupDragHandle, { button: 0, buttons: 1 });
    fireEvent.pointerMove(calendarRow!, { buttons: 1 });
    fireEvent.pointerUp(calendarRow!, { button: 0, buttons: 0 });
    await user.click(screen.getByRole('button', { name: 'Сохранить' }));

    await waitFor(() => expect(apiMock.updateNavigationSettings).toHaveBeenCalled());
    const [order, , groups] = apiMock.updateNavigationSettings.mock.calls.at(-1)!;
    const group = groups.find((candidate) => candidate.name === 'Бухгалтерия');
    expect(group?.itemIds).toEqual(['accounts', 'acts']);
    expect(order[0]).toBe('workspace');
    expect(order[1]).toBe(group?.id);
    expect(order).not.toContain('accounts');
    expect(order).not.toContain('acts');
    expect(await screen.findByRole('button', { name: /Бухгалтерия/i })).toBeTruthy();
  });

  it('shows grouped sections only when they are allowed for the current role', async () => {
    authState.isAdmin = false;
    authState.roleId = 100;
    authState.roleName = 'Юрист';
    apiMock.getRolePermissions.mockResolvedValueOnce(createLawyerTemplatePermissions());
    apiMock.getNavigationSettings.mockResolvedValueOnce({
      order: ['group-contacts', 'reports'],
      labels: {},
      groups: [{ id: 'group-contacts', name: 'Работа с клиентами', itemIds: ['contacts'] }],
      updatedAt: null,
    });

    renderNavigation();

    const group = await screen.findByRole('button', { name: /Работа с клиентами/i });
    expect(group).toBeTruthy();
    expect(findLinkByHref(getTabHref('contacts'))).toBeTruthy();
    expect(findLinkByHref(getTabHref('legalEntities'))).toBeFalsy();
    expect(screen.queryByRole('button', { name: 'Группы и порядок' })).toBeNull();
  });

  it.each([false, true])('limits grouped accounting and management for a secretary, invoice access: %s', async (canViewAccounts) => {
    authState.isAdmin = false;
    authState.roleName = 'Секретарь';
    apiMock.getRolePermissions.mockResolvedValueOnce({
      ...defaultRestrictedRolePermissions,
      calendar: { ...defaultRestrictedRolePermissions.calendar, canView: true },
      tasks: { ...defaultRestrictedRolePermissions.tasks, canView: true },
      accounts: { ...defaultRestrictedRolePermissions.accounts, canView: canViewAccounts },
    });
    apiMock.getNavigationSettings.mockResolvedValueOnce({
      order: ['group-accounting', 'group-management'],
      labels: {},
      groups: [
        { id: 'group-accounting', name: 'Бухгалтерия', itemIds: ['accounts', 'money', 'payments', 'acts', 'contracts'] },
        { id: 'group-management', name: 'Управление', itemIds: ['users', 'roles', 'audit', 'userActivity', 'settings'] },
      ],
      updatedAt: null,
    });

    renderNavigation();
    await waitFor(() => expect(findLinkByHref(getTabHref('tasks'))).toBeTruthy());
    if (canViewAccounts) await screen.findByRole('button', { name: /Бухгалтерия/i });

    expect(Boolean(screen.queryByRole('button', { name: /Бухгалтерия/i }))).toBe(canViewAccounts);
    expect(Boolean(findLinkByHref(getTabHref('accounts')))).toBe(canViewAccounts);
    for (const tab of ['moneyBank', 'payments', 'acts', 'contracts', 'users', 'roles', 'audit', 'userActivity', 'settings'] as Tab[]) {
      expect(findLinkByHref(getTabHref(tab)), `secretary menu must hide ${tab}`).toBeFalsy();
    }
    expect(screen.queryByRole('button', { name: /Управление/i })).toBeNull();
    expect(apiMock.getPaymentsV2).not.toHaveBeenCalled();
  });

  it('toggles a custom group from its default expanded state', async () => {
    apiMock.getNavigationSettings.mockResolvedValueOnce({
      order: ['group-contacts'], labels: {},
      groups: [{ id: 'group-contacts', name: 'Работа с клиентами', itemIds: ['contacts'] }],
      updatedAt: null,
    });
    render(<Navigation activeTab="calendar" onTabChange={vi.fn()} />);
    const group = await screen.findByRole('button', { name: /Работа с клиентами/i });
    expect(findLinkByHref(getTabHref('contacts'))).toBeTruthy();
    fireEvent.click(group);
    expect(findLinkByHref(getTabHref('contacts'))).toBeFalsy();
    fireEvent.click(group);
    expect(findLinkByHref(getTabHref('contacts'))).toBeTruthy();
  });

  it('shows settings for a non-admin role that can view integrations only', async () => {
    authState.isAdmin = false;
