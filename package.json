{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:all": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:legal-e2e": "node scripts/run-legal-e2e-smoke.mjs",
    "test:legal-e2e:frontend": "node scripts/run-legal-e2e-smoke.mjs --public-only --scenarios=frontend-shell",
    "test:legal-e2e:public": "node scripts/run-legal-e2e-smoke.mjs --public-only --scenarios=frontend-shell,features",
    "test:legal-legacy-data": "node scripts/run-legal-e2e-smoke.mjs --scenarios=legacy-clients,legacy-invoices,legacy-payments,legacy-tasks",
    "test:legal-load": "node scripts/run-legal-load-check.mjs",
    "test:legal-readiness": "node scripts/run-legal-readiness-report.mjs",
    "test:legal-readiness:backup": "node scripts/run-legal-readiness-report.mjs --skip-e2e --skip-load --require-database-backup --max-backup-age-hours=24",
    "test:legal-readiness:frontend": "node scripts/run-legal-readiness-report.mjs --public-only --skip-api-summary --skip-load --e2e-scenarios=frontend-shell",
    "test:legal-release-gate": "node scripts/run-legal-readiness-report.mjs --require-database-backup --max-backup-age-hours=24 --fail-on-enabled-legal-flags --fail-on-broad-scopes --allowed-broad-scope-roles=admin --require-assigned-expected-roles",
    "test:legal-flags:strict": "node scripts/run-legal-readiness-report.mjs --public-only --skip-e2e --skip-load --fail-on-enabled-legal-flags",
    "test:legal-roles": "node scripts/run-legal-readiness-report.mjs --skip-e2e --skip-load --skip-database-summary",
    "test:legal-roles:assigned": "node scripts/run-legal-readiness-report.mjs --skip-e2e --skip-load --skip-database-summary --require-assigned-expected-roles",
    "test:legal-roles:strict": "node scripts/run-legal-readiness-report.mjs --skip-e2e --skip-load --skip-database-summary --fail-on-broad-scopes --allowed-broad-scope-roles=admin",
    "test:guard": "vitest run src/App.routing.test.ts src/components/Navigation/Navigation.test.tsx",
    "test:ci": "npm run test:guard && npm run test:unit",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.2"
  }
}
