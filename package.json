{
  "name": "payplanner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "audit:dates": "node scripts/audit-date-time.mjs",
    "audit:dates:test": "node scripts/audit-date-time.mjs --self-test",
    "audit:encoding": "node scripts/check-source-encoding.mjs",
    "audit:encoding:test": "node scripts/check-source-encoding.mjs --self-test",
    "audit:reference-cache": "node scripts/verify-reference-assembly-cache.mjs",
    "audit:surface": "node scripts/audit-system-surface.mjs",
    "audit:surface:test": "node scripts/audit-system-surface.mjs --self-test",
    "audit:surface:update": "node scripts/audit-system-surface.mjs --write",
    "audit:encryption-inventory": "node scripts/audit-field-encryption-inventory.mjs",
    "audit:encryption-inventory:update": "node scripts/audit-field-encryption-inventory.mjs --write",
    "deploy:verify-production": "node scripts/run-production-deploy-readiness.mjs",
    "roadmap:advance-status": "node scripts/check-advance-roadmap-status.mjs docs/archive/roadmaps/unallocated-advance-monitoring-roadmap-2026-06-12.md",
    "roadmap:advance-status:test": "node scripts/check-advance-roadmap-status.mjs --self-test",
    "roadmap:acceptance-package": "node scripts/check-roadmap-acceptance-package.mjs",
    "roadmap:active-progress": "node scripts/check-active-roadmap-progress.mjs",
    "roadmap:active-progress:test": "node --test scripts/check-active-roadmap-progress-self-test.mjs",
    "roadmap:decision-package": "node scripts/check-roadmap-decision-package.mjs",
    "test": "npm run test:unit",
    "test:all": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.integration.test.*\" --maxWorkers=3",
    "test:unit:serial": "vitest run --exclude \"**/*.integration.test.*\" --no-file-parallelism",
    "test:watch": "vitest --exclude \"**/*.integration.test.*\" --maxWorkers=2",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:advance-acceptance": "node scripts/run-advance-acceptance-smoke.mjs",
    "test:legal-e2e": "node scripts/run-legal-e2e-smoke.mjs",
    "test:legal-e2e:frontend": "node scripts/run-legal-e2e-smoke.mjs --public-only --scenarios=frontend-shell",
    "test:legal-e2e:public": "node scripts/run-legal-e2e-smoke.mjs --public-only --scenarios=frontend-shell,features",
    "test:legal-legacy-data": "node scripts/run-legal-e2e-smoke.mjs --scenarios=legacy-clients,legacy-invoices,legacy-payments,legacy-tasks",
    "test:legal-load": "node scripts/run-legal-load-check.mjs",
    "test:legal-readiness": "node scripts/run-legal-readiness-report.mjs",
    "test:legal-readiness:backup": "node scripts/run-legal-readiness-report.mjs --skip-e2e --skip-load --require-database-backup --max-backup-age-hours=24",
    "test:legal-readiness:frontend": "node scripts/run-legal-readiness-report.mjs --public-only --skip-api-summary --skip-load --e2e-scenarios=frontend-shell",
    "test:legal-release-gate": "node scripts/run-legal-readiness-report.mjs --require-database-backup --max-backup-age-hours=24 --fail-on-enabled-legal-flags --fail-on-broad-scopes --allowed-broad-scope-roles=admin --require-assigned-expected-roles",
    "test:legal-flags:strict": "node scripts/run-legal-readiness-report.mjs --public-only --skip-e2e --skip-load --fail-on-enabled-legal-flags",
    "test:legal-roles": "node scripts/run-legal-readiness-report.mjs --skip-e2e --skip-load --skip-database-summary",
    "test:legal-roles:assigned": "node scripts/run-legal-readiness-report.mjs --skip-e2e --skip-load --skip-database-summary --require-assigned-expected-roles",
    "test:legal-roles:strict": "node scripts/run-legal-readiness-report.mjs --skip-e2e --skip-load --skip-database-summary --fail-on-broad-scopes --allowed-broad-scope-roles=admin",
    "test:guard": "vitest run src/App.routing.test.ts src/components/Navigation/Navigation.test.tsx",
    "test:role-permissions-smoke": "node scripts/run-role-permission-smoke.mjs",
    "test:browser-downloads": "node scripts/run-browser-download-smoke.mjs",
    "test:notification-readiness": "node scripts/run-notification-production-readiness.mjs",
    "test:visual-smoke": "node scripts/run-visual-smoke.mjs",
    "test:ci": "npm run test:guard && npm run test:unit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-legacy": "8.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.18",
    "braces": "file:vendor/braces-depth-guard/braces-3.0.3-payplanner.2.tgz",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.9.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.1",
    "terser": "5.46.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^8.1.6",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "braces": "$braces",
    "postcss-selector-parser": "7.1.6",
    "undici": "7.30.1"
  }
}
