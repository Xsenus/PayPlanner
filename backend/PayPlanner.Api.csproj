<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Title>PayPlanner</Title>
    <Authors>ilel@list.ru</Authors>
    <Copyright>ilel@list.ru</Copyright>
    <AssemblyVersion>1.0.0.6</AssemblyVersion>
    <FileVersion>1.0.0.6</FileVersion>
    <UserSecretsId>payplanner-api-local-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.23.5" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.8.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.9" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.14.0" />
    <PackageReference Include="PuppeteerSharp" Version="24.40.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="SourceGear.sqlite3" Version="3.53.4" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.9" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
    <PackageReference Include="WebPush" Version="1.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json;appsettings.Local*.json" CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="Assets\Fonts\DejaVuSansCondensed.ttf">
      <LogicalName>PayPlanner.Fonts.DejaVuSansCondensed.ttf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\Fonts\DejaVuSansCondensed-Bold.ttf">
      <LogicalName>PayPlanner.Fonts.DejaVuSansCondensed-Bold.ttf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\Fonts\LiberationSans-Regular.ttf">
      <LogicalName>PayPlanner.Fonts.LiberationSans-Regular.ttf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\Fonts\LiberationSans-Bold.ttf">
      <LogicalName>PayPlanner.Fonts.LiberationSans-Bold.ttf</LogicalName>
    </EmbeddedResource>

    <Compile Remove="PayPlanner.Api.Tests\**\*.cs" />
    <Compile Remove="PayPlanner.Api.Migrations\**\*.cs" />
    <Compile Remove=".codex-build\**\*.cs" />
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove="backend\**\*.cs" />
    <Compile Remove="publish\**\*.cs" />
    <Content Remove="PayPlanner.Api.Tests\**\*" />
    <Content Remove="PayPlanner.Api.Migrations\**\*" />
    <Content Remove=".codex-build\**\*" />
    <Content Remove="obj\**\*" />
    <Content Remove="backend\**\*" />
    <Content Remove="publish\**\*" />
    <EmbeddedResource Remove="PayPlanner.Api.Tests\**\*" />
    <EmbeddedResource Remove="PayPlanner.Api.Migrations\**\*" />
    <EmbeddedResource Remove=".codex-build\**\*" />
    <EmbeddedResource Remove="obj\**\*" />
    <EmbeddedResource Remove="backend\**\*" />
    <EmbeddedResource Remove="publish\**\*" />
    <None Remove="PayPlanner.Api.Tests\**\*" />
    <None Remove="PayPlanner.Api.Migrations\**\*" />
    <None Remove=".codex-build\**\*" />
    <None Remove="obj\**\*" />
    <None Remove="backend\**\*" />
    <None Remove="publish\**\*" />
  </ItemGroup>

  <!--
    Миграции живут в отдельной сборке PayPlanner.Api.Migrations. Прямая ссылка проекта API на неё невозможна
    (она ссылается на API), поэтому сборка запускается вложенным вызовом после компиляции API, а её DLL
    копируется в выходной каталог и в публикацию. Пропустить шаг можно только свойством
    PayPlannerSkipMigrationsBuild=true (например, когда сборку миграций уже выполнил граф проектов).
  -->
  <PropertyGroup>
    <MigrationsProjectPath>$(MSBuildProjectDirectory)\PayPlanner.Api.Migrations\PayPlanner.Api.Migrations.csproj</MigrationsProjectPath>
    <MigrationsOutputDll>$(MSBuildProjectDirectory)\PayPlanner.Api.Migrations\bin\$(Configuration)\$(TargetFramework)\PayPlanner.Api.Migrations.dll</MigrationsOutputDll>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MigrationsOutputDll)" Link="PayPlanner.Api.Migrations.dll" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildMigrationsAssembly" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(PayPlannerSkipMigrationsBuild)' != 'true'">
    <MSBuild Projects="$(MigrationsProjectPath)" Targets="Restore" Properties="Configuration=$(Configuration);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Projects="$(MigrationsProjectPath)" Targets="Build" Properties="Configuration=$(Configuration);BuildProjectReferences=false" />
    <Copy SourceFiles="$(MigrationsOutputDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
