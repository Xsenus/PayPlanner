<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="9.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\\PayPlanner.Api.csproj" AdditionalProperties="PayPlannerSkipMigrationsBuild=true" />
    <ProjectReference Include="..\\PayPlanner.Api.Migrations\\PayPlanner.Api.Migrations.csproj" />
    <ProjectReference Include="../../tests/PayPlanner.StorageStageWriterProbe/PayPlanner.StorageStageWriterProbe.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyStorageStageWriterProbe" AfterTargets="Build">
    <MSBuild Projects="../../tests/PayPlanner.StorageStageWriterProbe/PayPlanner.StorageStageWriterProbe.csproj"
             Targets="GetTargetPath" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="StageWriterProbeOutput" />
    </MSBuild>
    <Copy SourceFiles="@(StageWriterProbeOutput);@(StageWriterProbeOutput->'%(RootDir)%(Directory)%(Filename).deps.json');@(StageWriterProbeOutput->'%(RootDir)%(Directory)%(Filename).runtimeconfig.json')"
          DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Compile Remove=".codex-build\\**\\*.cs" />
    <EmbeddedResource Remove=".codex-build\\**\\*" />
    <None Remove=".codex-build\\**\\*" />
    <None Update="Fixtures\\**\\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../tools/PayPlanner.TestShards/ShardPlan.cs" Link="TestShards/ShardPlan.cs" />
    <Compile Include="../../tools/PayPlanner.TestShards/TestTimings.cs" Link="TestShards/TestTimings.cs" />
    <Compile Include="../../tools/PayPlanner.TestShards/TrxVerifier.cs" Link="TestShards/TrxVerifier.cs" />
    <Compile Include="../../tools/PayPlanner.TestShards/AssemblyCatalog.cs" Link="TestShards/AssemblyCatalog.cs" />
    <Compile Include="../../tools/PayPlanner.TestShards/ExecutionScheduling.cs" Link="TestShards/ExecutionScheduling.cs" />
    <Compile Include="../../tools/PayPlanner.TestShards/BatchResults.cs" Link="TestShards/BatchResults.cs" />
    <Compile Include="../../tools/PayPlanner.TestShards/OwnedOutputDrain.cs" Link="TestShards/OwnedOutputDrain.cs" />
    <Compile Include="../../tools/PayPlanner.TestShards/BoundedBatchScheduler.cs" Link="TestShards/BoundedBatchScheduler.cs" />
    <EmbeddedResource Include="../../tools/PayPlanner.TestShards/baseline-timings.json" LogicalName="PayPlanner.TestShards.baseline-timings.json" />
  </ItemGroup>

</Project>
