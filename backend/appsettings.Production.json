{
  "Database": {
    "Provider": "sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=payplanner.db"
  },
  "Backup": {
    "IntervalHours": 6,
    "Directory": "backups",
    "MaxFiles": 30
  },
  "DatabaseBackup": {
    "Enabled": true,
    "ScheduleLocal": "00:00,06:00,12:00,18:00",
    "RetentionDays": 8,
    "Directory": "backups",
    "PgDumpPath": ""
  },
  "Urls": "http://0.0.0.0:5080",
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
