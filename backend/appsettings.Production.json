{
  "Database": {
    "Provider": "sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=payplanner.db"
  },
  "App": {
    "FrontendUrl": "https://crm.elitpravo.com/"
  },
  "Backup": {
    "IntervalHours": 6,
    "Directory": "backups",
    "MaxFiles": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "https://crm.elitpravo.com",
      "http://185.46.10.202",
      "https://185.46.10.202"
    ]
  },
  "DatabaseBackup": {
    "Enabled": true,
    "ScheduleLocal": "00:00,06:00,12:00,18:00",
    "RetentionDays": 8,
    "Format": "zip",
    "Directory": "backups",
    "PgDumpPath": ""
  },
  "Urls": "http://0.0.0.0:5080",
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
