<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Сгенерированные миграции EF и снимки модели (≈1,8 млн строк) вынесены из PayPlanner.Api, чтобы изменение
    контроллера или сервиса не пересобирало их. Проект ссылается на API только ради типов контекстов
    ([DbContext(typeof(...))]); эталонная сборка API не меняется при правке тел методов, поэтому эта сборка
    пересобирается только при изменении миграций или публичного контракта API.
    PayPlanner.Api собирает этот проект вложенным вызовом (см. PayPlanner.Api.csproj) и копирует DLL рядом с собой.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PayPlanner.Api.Migrations</AssemblyName>
    <RootNamespace>PayPlanner.Api</RootNamespace>
    <IsPackable>false</IsPackable>
    <AssemblyVersion>1.0.0.6</AssemblyVersion>
    <FileVersion>1.0.0.6</FileVersion>
    <!-- Коммит документации не меняет код миграций; ревизия поставки проверяется отдельным файлом REVISION. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PayPlanner.Api.csproj" AdditionalProperties="PayPlannerSkipMigrationsBuild=true" />
  </ItemGroup>

  <!-- The API cannot reference its migrations without a cycle. Copy after this graph node has
       actually built, so tests/solution builds never use a stale or merely existing DLL. -->
  <Target Name="CopyMigrationsToApi" AfterTargets="Build">
    <MSBuild Projects="..\PayPlanner.Api.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);PayPlannerSkipMigrationsBuild=true;BuildProjectReferences=false">
      <Output TaskParameter="TargetOutputs" ItemName="_ApiAssemblyTargetPath" />
    </MSBuild>
    <Error Condition="'@(_ApiAssemblyTargetPath)' == ''" Text="Не удалось определить выходную сборку API для миграций." />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="@(_ApiAssemblyTargetPath->'%(RootDir)%(Directory)PayPlanner.Api.Migrations.dll')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
