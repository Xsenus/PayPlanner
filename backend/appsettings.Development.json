{
  "Database": {
    "Provider": "postgresql"
  },
  "ConnectionStrings": {
    "Default": "Host=127.0.0.1;Port=5433;Database=payplanner;Username=postgres"
  },
  "Backup": {
    "IntervalHours": 6,
    "Directory": "backups",
    "MaxFiles": 30
  },
  "DatabaseBackup": {
    "Enabled": true,
    "ScheduleLocal": "00:00,06:00,12:00,18:00",
    "RetentionDays": 8,
    "Format": "backup",
    "Directory": "backups",
    "PgDumpPath": "C:\\Program Files\\PostgreSQL\\17\\bin\\pg_dump.exe"
  },
  "Urls": "http://localhost:5080",
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Seed": {
    "ClientsAndPayments": false
  }
}
