{
  "Database": {
    "Provider": "sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=payplanner.db"
  },
  "MessengerDocumentDelivery": {
    "Enabled": false,
    "LinkLifetimeHours": 24,
    "AuditRetentionDays": 365,
    "Providers": {
      "Telegram": {
        "Enabled": false
      },
      "Max": {
        "Enabled": false
      },
      "WhatsAppBusiness": {
        "Enabled": false
      }
    }
  },
  "Backup": {
    "IntervalHours": 6,
    "Directory": "backups",
    "MaxFiles": 30
  },
  "FileStorage": {
    "RootPath": ""
  },
  "DatabaseBackup": {
    "Enabled": true,
    "ScheduleLocal": "00:00,06:00,12:00,18:00",
    "RetentionDays": 8,
    "Format": "zip",
    "Directory": "backups",
    "PgDumpPath": ""
  },
  "InvoicePaymentStateReconciliation": {
    "Enabled": true,
    "StartupDelayMinutes": 5,
    "IntervalMinutes": 15,
    "BatchSize": 500
  },
  "FeatureFlags": {
    "Legal": {
      "ExternalCourtSync": false,
      "KadArbitrCourtSync": false,
      "MosGorSudCourtSync": false,
      "ExternalCalendarSync": false,
      "CourtEvents": false,
      "DocumentTemplateLibrary": false,
      "ExternalWorkOrderApproval": false,
      "ClientPortal": false,
      "OfflineCalendarReadOnly": false
    }
  },
  "LegalIntegrations": {
    "CourtSyncMetrics": {
      "RetentionDays": 90,
      "IntervalHours": 1
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Diagnostics": {
    "SlowHttpRequests": {
      "Enabled": true,
      "ThresholdMilliseconds": 1000
    },
    "SlowDatabaseCommands": {
      "Enabled": true,
      "ThresholdMilliseconds": 500
    }
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "PayPlanner",
    "Audience": "PayPlanner"
  },
  "DaData": {
    "ApiKey": "",
    "Secret": "",
    "BaseUrl": "https://suggestions.dadata.ru/suggestions/api/4_1/rs"
  },
  "Email": {
    "Enabled": false,
    "SmtpHost": "smtp.your-provider.com",
    "SmtpPort": 587,
    "SmtpUsername": "no-reply@your-domain.com",
    "SmtpPassword": "",
    "FromEmail": "no-reply@your-domain.com",
    "FromName": "PayPlanner"
  },
  "WebPush": {
    "Enabled": true,
    "PublicKey": "",
    "PrivateKey": "",
    "Subject": "mailto:admin@payplanner.local"
  },
  "AllowedHosts": "*"
}
