{
  "Database": {
    "Provider": "sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=payplanner.db"
  },
  "ElectronicSignature": {
    "Enabled": false,
    "PreparationEnabled": true,
    "StorageRoot": "",
    "DefaultSignatureType": "qualified",
    "DefaultSigningOrder": "sequential",
    "DefaultArchiveRetentionYears": 10,
    "Providers": {
      "KonturDiadoc": { "Enabled": false },
      "Sbis": { "Enabled": false },
      "Taxcom": { "Enabled": false }
    }
  },
  "ProfilePhotos": {
    "StorageRoot": ""
  },
  "FieldEncryption": {
    "Enabled": false,
    "ClientPassportDualWriteEnabled": false,
    "ClientPassportBackfillEnabled": false,
    "ClientPassportBackfillBatchSize": 50,
    "ActiveKeyId": "",
    "Keys": {}
  },
  "MaxMessenger": {
    "BotUsername": ""
  },
  "MessengerDocumentDelivery": {
    "Enabled": false,
    "PublicBaseUrl": "",
    "BatchSize": 20,
    "LinkLifetimeHours": 24,
    "AuditRetentionDays": 365,
    "DirectAttachments": {
      "Enabled": false,
      "AllowedMimeTypes": [
        "application/pdf"
      ],
      "MaxBytes": 0,
      "Antivirus": {
        "Enabled": false
      }
    },
    "Providers": {
      "Telegram": {
        "Enabled": false,
        "WebhookSecret": ""
      },
      "Max": {
        "Enabled": false,
        "WebhookSecret": ""
      },
      "WhatsAppBusiness": {
        "Enabled": false,
        "WebhookSecret": ""
      }
    }
  },
  "Backup": {
    "IntervalHours": 6,
    "Directory": "backups",
    "MaxFiles": 30
  },
  "FileStorage": {
    "RootPath": ""
  },
  "StorageOrchestration": {
    "Enabled": false,
    "PolicyDryRunEnabled": false,
    "WorkerEnabled": false,
    "WorkerBatchSize": 20,
    "WorkerPollSeconds": 10,
    "WorkerLeaseSeconds": 120,
    "WorkerMaxAttempts": 8,
    "ProviderFailureThreshold": 3,
    "ProviderCircuitBreakSeconds": 60,
    "ProviderConnections": {},
    "LocalRoot": "",
    "DefaultPolicy": {
      "Version": "local-v1",
      "RequiredCopies": 1,
      "WriteProviders": [ "local" ],
      "ReadProviders": [ "local" ],
      "RequireConditionalCreate": true,
      "RequireRangeReads": false,
      "LegalHold": false
    }
  },
  "S3Storage": {
    "EndpointSecurity": {
      "Enabled": true,
      "AllowHttp": false,
      "AllowPrivateNetworks": false,
      "AllowedHosts": []
    }
  },
  "DatabaseBackup": {
    "Enabled": true,
    "ScheduleLocal": "00:00,06:00,12:00,18:00",
    "RetentionDays": 8,
    "Format": "zip",
    "Directory": "backups",
    "PgDumpPath": "",
    "IncludeFileStorage": true,
    "RecoveryKeyReference": ""
  },
  "DatabaseRestoreDrill": {
    "RootDirectory": "restore-drills",
    "PostgreSqlExecutionEnabled": false,
    "PostgreSqlTargetConnectionString": "",
    "ConfirmationToken": "",
    "AllowedPostgreSqlDatabases": [],
    "PgRestorePath": "",
    "PsqlPath": "",
    "TimeoutMinutes": 30
  },
  "InvoicePaymentStateReconciliation": {
    "Enabled": true,
    "StartupDelayMinutes": 5,
    "IntervalMinutes": 15,
    "BatchSize": 500
  },
  "FeatureFlags": {
    "Legal": {
      "ExternalCourtSync": false,
      "KadArbitrCourtSync": false,
      "MosGorSudCourtSync": false,
      "ExternalCalendarSync": false,
      "CourtEvents": false,
      "DocumentTemplateLibrary": false,
      "ExternalWorkOrderApproval": false,
      "ClientPortal": false,
      "OfflineCalendarReadOnly": false
    }
  },
  "LegalIntegrations": {
    "CourtSyncMetrics": {
      "RetentionDays": 90,
      "IntervalHours": 1
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Diagnostics": {
    "SlowHttpRequests": {
      "Enabled": true,
      "ThresholdMilliseconds": 1000
    },
    "SlowDatabaseCommands": {
      "Enabled": true,
      "ThresholdMilliseconds": 500
    }
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "PayPlanner",
    "Audience": "PayPlanner"
  },
  "DaData": {
    "ApiKey": "",
    "Secret": "",
    "BaseUrl": "https://suggestions.dadata.ru/suggestions/api/4_1/rs"
  },
  "Email": {
    "Enabled": false,
    "SmtpHost": "smtp.your-provider.com",
    "SmtpPort": 587,
    "SmtpUsername": "no-reply@your-domain.com",
    "SmtpPassword": "",
    "FromEmail": "no-reply@your-domain.com",
    "FromName": "PayPlanner"
  },
  "WebPush": {
    "Enabled": true,
    "PublicKey": "",
    "PrivateKey": "",
    "Subject": "mailto:admin@payplanner.local"
  },
  "AllowedHosts": "*"
}
