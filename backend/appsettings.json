{
  "Database": {
    "Provider": "sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=payplanner.db"
  },
  "Backup": {
    "IntervalHours": 6,
    "Directory": "backups",
    "MaxFiles": 30
  },
  "DatabaseBackup": {
    "Enabled": true,
    "ScheduleLocal": "00:00,06:00,12:00,18:00",
    "RetentionDays": 8,
    "Format": "zip",
    "Directory": "backups",
    "PgDumpPath": ""
  },
  "InvoicePaymentStateReconciliation": {
    "Enabled": true,
    "StartupDelayMinutes": 5,
    "IntervalMinutes": 15,
    "BatchSize": 500
  },
  "FeatureFlags": {
    "Legal": {
      "ExternalCourtSync": false,
      "ExternalCalendarSync": false,
      "CourtEvents": false,
      "DocumentTemplateLibrary": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "PayPlanner",
    "Audience": "PayPlanner"
  },
  "DaData": {
    "ApiKey": "",
    "Secret": "",
    "BaseUrl": "https://suggestions.dadata.ru/suggestions/api/4_1/rs"
  },
  "Email": {
    "Enabled": false,
    "SmtpHost": "smtp.your-provider.com",
    "SmtpPort": 587,
    "SmtpUsername": "no-reply@your-domain.com",
    "SmtpPassword": "",
    "FromEmail": "no-reply@your-domain.com",
    "FromName": "PayPlanner"
  },
  "AllowedHosts": "*"
}
